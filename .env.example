# Root-level shared variables. Used by docker-compose.yml only.
# App-specific env lives in apps/api/.env and apps/web/.env (see those .env.example files).
#
# Copy this file to .env and adjust ports if 5432/6379 are taken on your machine.

# Postgres (matches docker-compose.yml)
POSTGRES_USER=olives
POSTGRES_PASSWORD=olives
POSTGRES_DB=olives
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379
