{
  "name": "olives",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "dev:worker": "pnpm --filter @olives/api dev:worker",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "db:migrate": "pnpm --filter @olives/api exec prisma migrate dev",
    "db:migrate:deploy": "pnpm --filter @olives/api exec prisma migrate deploy",
    "db:studio": "pnpm --filter @olives/api exec prisma studio",
    "db:generate": "pnpm --filter @olives/api exec prisma generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.59.4"
  }
}
