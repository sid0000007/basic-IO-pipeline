NODE_ENV=development
PORT=3001

# DATABASE_URL host port must match docker-compose .env POSTGRES_PORT.
# Default host port for fresh setups: 5432. This developer's local override: 5434.
DATABASE_URL=postgresql://olives:olives@localhost:5432/olives

# REDIS_URL host port must match docker-compose .env REDIS_PORT.
REDIS_URL=redis://localhost:6379

LOG_LEVEL=info

# Phase 1: LLM provider key. Anthropic Claude.
# Get one at https://console.anthropic.com/. Required for chat to work.
ANTHROPIC_API_KEY=sk-ant-replace-me

# Comma-separated allowlist of browser origins for CORS. Web app dev defaults to :3000.
CORS_ORIGIN=http://localhost:3000

# How many prior messages to include in the LLM context window per turn.
CHAT_CONTEXT_MESSAGE_LIMIT=20

# Phase 2: ingestion + worker config.
# Bearer token external producers send on POST /api/v1/ingestion/inference-logs.
# Min 8 chars. Use a long random string in production.
INGESTION_API_KEY=dev-ingestion-key-please-change

# Worker concurrency for the ingestion-processing queue.
INGESTION_QUEUE_CONCURRENCY=5

# Total attempts before a failed job lands in the dead-letter set.
INGESTION_MAX_ATTEMPTS=5

# When true, the worker redacts emails / phones / credit cards / SSNs from
# input/output previews before persisting. Default off in dev so previews
# stay readable when debugging.
PII_REDACTION_ENABLED=false

# Phase 3: additional LLM providers.
# Get a key at https://platform.openai.com/api-keys. Required by env validation
# even if you only ever use Anthropic — set a placeholder if so.
OPENAI_API_KEY=sk-placeholder

# Get a key at https://aistudio.google.com/apikey. Required by env validation;
# set a placeholder if you don't use Gemini.
GEMINI_API_KEY=placeholder

# Phase 3: rate limiting via @nestjs/throttler. Limits are per-IP per window.
THROTTLER_TTL_SECONDS=60
THROTTLER_CHAT_LIMIT=30
THROTTLER_INGESTION_LIMIT=600

# Phase 3: retention. Worker drops inference_events older than this; archives
# (nulls payload of) ingestion_logs older than this. Daily 3am cron.
RETENTION_DAYS=90
