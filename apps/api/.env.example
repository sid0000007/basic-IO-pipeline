NODE_ENV=development
PORT=3001

# DATABASE_URL host port must match docker-compose .env POSTGRES_PORT.
# Default host port for fresh setups: 5432. This developer's local override: 5434.
DATABASE_URL=postgresql://olives:olives@localhost:5432/olives

# REDIS_URL host port must match docker-compose .env REDIS_PORT.
REDIS_URL=redis://localhost:6379

LOG_LEVEL=info
